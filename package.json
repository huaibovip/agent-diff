{
  "name": "agent-diff",
  "displayName": "Agent Diff",
  "description": "Review all file changes made by Claude Code sessions with diffs and one-click revert",
  "version": "1.0.1",
  "publisher": "Huaibo",
  "icon": "resources/icon-color.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/huaibovip/agent-diff"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "checkpoints",
    "diff",
    "revert",
    "AI",
    "changes"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agent-diff",
          "title": "Agent Diff",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "agent-diff": [
        {
          "id": "AgentDiff",
          "name": "Agent Diff",
          "type": "webview",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "AgentDiff.refresh",
        "title": "Refresh Changes",
        "icon": "$(refresh)"
      },
      {
        "command": "AgentDiff.viewDiff",
        "title": "View Changes",
        "icon": "$(diff)"
      },
      {
        "command": "AgentDiff.viewFile",
        "title": "View File",
        "icon": "$(file)"
      },
      {
        "command": "AgentDiff.restoreFile",
        "title": "Restore File",
        "icon": "$(discard)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "AgentDiff.refresh",
          "when": "view == AgentDiff",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "AgentDiff.viewDiff",
          "when": "view == AgentDiff && viewItem == checkpointFile",
          "group": "inline"
        },
        {
          "command": "AgentDiff.viewFile",
          "when": "view == AgentDiff && viewItem == checkpointFile"
        },
        {
          "command": "AgentDiff.restoreFile",
          "when": "view == AgentDiff && viewItem == checkpointFile"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
